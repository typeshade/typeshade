{
  // X-GIS #1681 B1 — the compiler baseline. Every tsconfig in this package extends this
  // file and nothing outside it.
  //
  // It began as a COPY of the X-GIS monorepo root's baseline, made when the package still
  // lived there and every tsconfig said `extends "../tsconfig.base.json"`. That made the
  // directory uncompilable anywhere else: a vendored source copy or an isolated checkout
  // has no `../tsconfig.base.json`, so `tsc -p .` failed before reading a single .ts file.
  //
  // It is no longer a copy of anything. The repository stands alone, so this file is the
  // single authority for the options below and the drift gate that pinned it to the
  // monorepo root is gone with the monorepo. `src/tsconfig-drift.test.ts` still fails if
  // any tsconfig in this package starts extending outside it — that invariant is about the
  // package and survives the split.
  "compilerOptions": {
    "target": "ES2022",
    // X-GIS #1686 — the two values below are inherited from that original baseline, and
    // every leaf config in this package OVERRIDES them with `nodenext`. Nothing compiles
    // with them as they stand; read tsconfig.json for why the override lives in the leaves
    // rather than here. Collapsing them into `nodenext` is now possible — nothing pins them
    // any more — but it is a change to what resolves, not a comment fix, so it is not this
    // commit's.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "types": ["@webgpu/types"]
  }
}
