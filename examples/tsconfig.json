{
  // Editor / typed-lint project for examples/. The PACKAGE tsconfig.json includes
  // only src/ (examples never reach dist/), so without this file the TS project
  // service — which discovers projects by walking tsconfig.json files — cannot
  // resolve any examples file, and typed ESLint (pre-commit lint-staged) fails to
  // parse them. The canonical type GATE for examples stays the package build's
  // `tsc -p tsconfig.tests.json` noEmit pass; this project mirrors its options.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // X-GIS #1683 — same inherited-rootDir bug as playground/e2e/tsconfig.json: the base
    // pins `rootDir: "./src"`, so every examples/ file is outside it and reports
    // TS6059 before any real checking happens. `..` = the package root, matching
    // tsconfig.tests.json's `"rootDir": "."` (the canonical gate for this directory).
    "rootDir": "..",
    "noEmit": true,
    // X-GIS #1686 — mirrors tsconfig.tests.json: nodenext, and no `allowImportingTsExtensions`.
    // The editor project must agree with the canonical gate about what resolves, or a
    // `.ts` specifier looks fine in the editor and fails the build.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  // Mirrors tsconfig.tests.json's exclude, and for the same reason it exists there: a
  // `.shade.ts` file is not TypeScript. It is `"use typeshade"` SOURCE for `compile()`,
  // where `vec4` / `u32` / `uniform<T>` are the shader language's names and the class
  // decorators are attribute syntax — 51 TS2304/TS1206 errors that say nothing about the
  // corpus. Without this the editor project and the canonical gate disagree about what
  // resolves, which is the drift this file's header exists to prevent, and typed ESLint
  // (pre-commit lint-staged) fails to parse five files the type check never claimed.
  // What DOES gate these files is `examples/shade-examples.test.ts`, which compiles every
  // one of them and pins its emits.
  "exclude": ["**/*.shade.ts"]
}
