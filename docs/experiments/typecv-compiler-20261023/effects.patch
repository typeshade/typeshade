diff --git a/src/core/passes/opt/helper-writes.test.ts b/src/core/passes/opt/helper-writes.test.ts
new file mode 100644
index 00000000..3b4fca16
--- /dev/null
+++ b/src/core/passes/opt/helper-writes.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from 'vitest';
+import { compile } from '../../../compiler/ts/compile.js';
+import { compileModule } from '../../oracle.js';
+import { emitModuleAt } from '../../backends/wgsl.js';
+import { cse } from './cse.js';
+import { licm } from './licm.js';
+import { fixpoint } from './optimize.js';
+
+const source = (body: string) => `"use typeshade";
+let changed: f32 = 1.;
+function write(x: f32): f32 { changed += x; return changed; }
+function indirect(x: f32): f32 { return write(x); }
+export function sample(x: f32): f32 { ${body} }
+`;
+
+describe('hoisting across helpers with precise write roots', () => {
+  it('shares an invariant across a helper store without sharing the store', () => {
+    const m = compile(
+      source(`
+      const a = sin(x * 2.);
+      indirect(x);
+      const b = sin(x * 2.);
+      return a + b + changed;
+    `),
+    ).module;
+    const out = cse(m);
+    expect(emitModuleAt(out, 'O0')).toContain('_cse');
+    for (const x of [-2, 0, 0.25, 1, 3])
+      expect(compileModule(out).fns.sample!(x)).toEqual(compileModule(m).fns.sample!(x));
+  });
+
+  it('keeps every effectful call and every read of a transitively changed root', () => {
+    for (const body of [
+      'return indirect(x * 2.) + indirect(x * 2.);',
+      'const a = sin(changed * x); indirect(x); const b = sin(changed * x); return a + b;',
+      'let sum: f32 = 0.; for (let i: u32 = 0; i < 3; i++) { sum += sin(changed * x); indirect(x); } return sum;',
+    ]) {
+      const m = compile(source(body)).module;
+      for (const pass of [cse, licm, fixpoint])
+        for (const x of [-2, 0, 0.25, 1, 3])
+          expect(compileModule(pass(m)).fns.sample!(x)).toEqual(compileModule(m).fns.sample!(x));
+    }
+  });
+
+  it('moves only the unaffected loop expression', () => {
+    const m = compile(
+      source(`
+      let sum: f32 = 0.;
+      for (let i: u32 = 0; i < 3; i++) { sum += sin(x); indirect(x); }
+      return sum + changed;
+    `),
+    ).module;
+    const out = licm(m);
+    expect(emitModuleAt(out, 'O0')).toContain('_licm');
+    for (const x of [-2, 0, 0.25, 1, 3])
+      expect(compileModule(out).fns.sample!(x)).toEqual(compileModule(m).fns.sample!(x));
+  });
+});
