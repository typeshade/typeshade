@@ -364,0 +382,19 @@ export function fnWrites(m: ModuleDecl): FnWrites {
+/** Ordinary helper stores have precise roots. Atomics, barriers, collection operations and
+ * opaque raw helpers retain the conservative whole-function hoisting boundary. */
+export function bodyHasOrderingEffect(body: readonly Stmt[], writes: FnWrites): boolean {
+  const ordering = orderingOf.get(writes);
+  if (ordering === undefined) return bodyHasEffectfulCall(body, writes);
+  let found = false;
+  for (const s of body)
+    eachStmtExpr(s, (e) =>
+      eachExpr(e, (x) => {
+        if (
+          x.op === 'call' &&
+          (ordering.has(x.fn) || (x.declRef === undefined && EFFECTFUL_INTRINSICS.has(x.fn)))
+        )
+          found = true;
+      }),
+    );
+  return found;
+}
