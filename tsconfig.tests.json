{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tests.tsbuildinfo",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": ["node", "@webgpu/types"]
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["examples/**/*.shade.ts"]
}
