{
  "name": "typeshade",
  "version": "0.0.1",
  "description": "A TypeScript shader DSL: author a typed node graph once and emit WGSL, GLSL ES 3.00, an f64 CPU oracle, and pipeline reflection from the same source.",
  "keywords": [
    "shader",
    "wgsl",
    "glsl",
    "webgpu",
    "webgl2",
    "gpu",
    "shading-language",
    "typescript",
    "reflection"
  ],
  "license": "MIT",
  "author": "Seungup Noh <seungup.noh@gmail.com>",
  "homepage": "https://typeshade.dev",
  "bugs": {
    "url": "https://github.com/typeshade/typeshade/issues"
  },
  "type": "module",
  "sideEffects": [
    "./src/core/ir/builder.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "bin": {
    "typeshade": "./src/cli/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./dev": "./src/dev.ts",
    "./debug": "./src/debug.ts",
    "./compute": "./src/compute.ts",
    "./emit-prod": "./src/emit-prod.ts",
    "./vite": "./src/vite.ts",
    "./runtime": "./src/runtime.ts",
    "./core/ir": "./src/core/ir/index.ts",
    "./examples": "./examples/index.ts",
    "./language-service": "./src/language-service/index.ts",
    "./shade": "./dist/shade.d.ts"
  },
  "files": [
    "dist",
    "src",
    "examples",
    "tsconfig.json",
    "tsconfig.base.json",
    "tsconfig.tests.json",
    "AUTHORING.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "!**/*.test.ts",
    "!**/__emit-goldens__",
    "!**/spec-conformance/fixtures",
    "!**/AGENTS.md",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/typeshade/typeshade.git"
  },
  "scripts": {
    "build": "tsc --build && bun scripts/emit-shade-dts.ts && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "typeshade": "bun src/cli/bin.ts",
    "bench:stepping": "bun scripts/bench-stepping.ts",
    "gate:compile": "bun scripts/compile-gate.ts",
    "gate:journeys": "bun scripts/user-journey.ts",
    "bake:goldens": "UPDATE_EMIT_GOLDENS=1 vitest run examples/emit-goldens.test.ts examples/shade-examples.test.ts examples/shade-twins.test.ts",
    "bake:api-surface": "bun scripts/bake-api-surface.ts",
    "bake:coredef": "bun scripts/bake-coredef-textures.ts",
    "bake:wgsl-names": "bun scripts/bake-wgsl-names.ts",
    "manifest:publish": "bun scripts/publish-manifest.ts",
    "docs:refs": "bun scripts/doc-refs.ts",
    "docs:impact": "bun scripts/doc-impact.ts",
    "changes:check": "bun scripts/changes.ts",
    "reqs:sync": "bun scripts/reqs-sync.ts",
    "lint": "eslint .",
    "format": "prettier --write . && bun scripts/semicolons.ts",
    "format:check": "prettier --check . && bun scripts/semicolons.ts --check",
    "format:compiler": "prettier --write src/compiler/**/*.ts",
    "format:semicolons": "bun scripts/semicolons.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@webgpu/types": "^0.1.69",
    "eslint": "^9",
    "playwright": "^1.59.1",
    "prettier": "^3.5.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <6"
  },
  "publishConfig": {
    "access": "public"
  }
}
